<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.abnen.wirefix"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="WireFix"
        android:debuggable="true"
        android:allowBackup="false">

        <activity
            android:name="com.abnen.wirefix.MainActivity"
            android:exported="true"
            android:label="WireFix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.abnen.wirefix.StateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.abnen.wirefix.ACCDET_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.abnen.wirefix.GuardService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
